[sub_resource type="GDScript" id="GDScript_4frjw"]
script/source = "extends Label

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta):
	#text = \"HP: \" + str(get_node(\"../../Player/Player\").health)
	text = \"HP: \" + str(Game.playerHP)
"

[sub_resource type="GDScript" id="GDScript_wyqc1"]
script/source = "extends Label

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta):
	text = \"Gold: \" + str(Game.gold)
"

[sub_resource type="GDScript" id="GDScript_j1fms"]
script/source = "extends Label

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta):
	text = \"Ammo: \" + str(Game.ammo) + \"/100\"
"

